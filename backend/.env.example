# Copy to .env and fill in values from https://developers.kite.trade/

KITE_API_KEY=
KITE_API_SECRET=
# Must match the redirect URL registered on your Kite Connect app
KITE_REDIRECT_URL=http://127.0.0.1:5173/investments?kite=callback
KITE_AUTO_SYNC_HOURS=6

# Optional — GoldAPI.io key for direct XAU/XAG INR quotes
# Without it, WealthPlanner uses free USD spot × live USD/INR
GOLD_API_KEY=
METALS_AUTO_REFRESH_HOURS=6
METALS_CACHE_SECONDS=300
